  "typography": {
    "family": {
      "heading": "'Bricolage Grotesque', Georgia, serif",
      "body": "'Plus Jakarta Sans', system-ui, sans-serif",
      "script": "'Kaushan Script', cursive"
    },
    "scriptUsage": ["header wordmark text", "footer wordmark text", "one short signature line near the call-to-action"],
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Kaushan+Script&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap",
    "scale": {
