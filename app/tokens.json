    "forbidden": [
      { "fg": "#1F7490", "bg": "#05263D", "reason": "about 2.9:1" },
      { "fg": "#FFFFFF", "bg": "#7FB5C7", "reason": "fails AA" },
      { "fg": "#3C5668", "bg": "#1F7490", "reason": "fails AA" }
