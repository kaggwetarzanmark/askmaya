    "border": { "card": "#D2E8EE", "input": "#7FB5C7", "focus": "#7FB5C7", "error": "#B3382A" },
    "action": { "primary": "#1F7490", "primaryHover": "#175A71", "dark": "#05263D", "darkHover": "#0B3A4F" }
  },
  "contrast": {
    "approved": [
      { "fg": "#05263D", "bg": "#FFFFFF", "ratio": "about 15:1" },
      { "fg": "#3C5668", "bg": "#FFFFFF", "ratio": "about 7.7:1" },
      { "fg": "#FFFFFF", "bg": "#1F7490", "ratio": "5.3:1" },
      { "fg": "#175A71", "bg": "#EAF4F7", "ratio": "above 7:1" },
      { "fg": "#7FB5C7", "bg": "#05263D", "ratio": "about 6.9:1" }
