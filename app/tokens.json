    "reducedMotion": "Stop the ticker and wrap chips statically, remove the rise and lifts, keep color changes"
  },
  "components": {
    "button": { "variants": ["primary", "dark", "outline", "light"], "height": 52, "radius": 999 },
    "input": { "height": 52, "radius": 999, "labelPosition": "above" },
    "card": { "radius": 28, "padding": 32, "variants": ["default", "tint", "dark"] },
    "badge": { "radius": 999, "variants": ["solid", "soft"] },
    "alert": { "radius": 16, "variants": ["success", "info", "error"] }
  },
  "content": {
    "currency": "UGX",
    "currencyFormat": "UGX 150,000",
    "phoneFormat": "+256 7XX XXX XXX",
    "contactChannels": ["phone", "WhatsApp", "email"],
    "placeholders": ["[YOUR PRICE]", "[PHONE]", "[EMAIL]", "[WHATSAPP]", "[NUMBER]", "[CUSTOMER NAME]", "[PHOTO: description]"],
    "voice": "Warm, clear, reassuring. Sentence case. Active voice. Specific over adjectival."
  }
