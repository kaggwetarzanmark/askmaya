      "h3": { "family": "heading", "size": "24px", "weight": 700, "lineHeight": 1.2 },
      "h4": { "family": "heading", "size": "20px", "weight": 700, "lineHeight": 1.3 },
      "bodyLarge": { "family": "body", "size": "19px", "weight": 400, "lineHeight": 1.7 },
      "body": { "family": "body", "size": "16px", "weight": 400, "lineHeight": 1.7 },
      "small": { "family": "body", "size": "14px", "weight": 500, "lineHeight": 1.5 },
      "button": { "family": "body", "size": "15px", "weight": 600, "lineHeight": 1 },
      "wordmark": { "family": "script", "size": "34px", "weight": 400, "lineHeight": 1 },
      "signature": { "family": "script", "size": "28px", "weight": 400, "lineHeight": 1 }
    },
    "maxLineLength": "38rem"
  },
  "spacing": { "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128], "unit": "px", "containerMax": 1200, "containerPadding": 24, "sectionPaddingMobile": 72, "sectionPaddingDesktop": 112, "gridGap": 24 },
  "radius": { "small": 16, "card": 28, "panel": 32, "textarea": 24, "pill": 999, "arch": "999px 999px 24px 24px" },
  "border": { "card": "1px solid #D2E8EE", "input": "1.5px solid #7FB5C7", "outlineButton": "2px solid #1F7490", "hexagonOutline": "2.5px solid #05263D" },
  "elevation": { "none": "none", "soft": "0 16px 40px rgba(5,38,61,0.10)" },
  "size": { "touchTarget": 48, "button": 52, "input": 52, "iconCircle": 64, "iconGlyph": 26, "avatar": 56 },
